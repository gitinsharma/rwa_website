# Copy to .env and fill in real values. Never commit .env.

# -----------------------------------------------------------------------------
# App / Auth.js
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: npx auth secret
AUTH_SECRET=

# -----------------------------------------------------------------------------
# Database (Postgres container is reachable at host "db" inside Docker)
# -----------------------------------------------------------------------------
POSTGRES_USER=rwa_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rwa_portal
# In Docker this resolves via the "db" service name, not localhost.
DATABASE_URL=postgresql://rwa_admin:changeme@db:5432/rwa_portal

# -----------------------------------------------------------------------------
# MinIO / S3 (MinIO container is reachable at host "storage" inside Docker)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=rwa_minio_admin
MINIO_ROOT_PASSWORD=changeme_min_8_chars
# Internal (server-to-server) endpoint used by the Next.js container.
MINIO_ENDPOINT=http://storage:9000
# Public endpoint residents' browsers use to download files directly (via Caddy).
MINIO_PUBLIC_ENDPOINT=https://files.sector43rwa.in
S3_BUCKET=rwa-files
S3_REGION=us-east-1
# Use a dedicated MinIO access key/secret (not the root user) for the app in production.
S3_ACCESS_KEY_ID=rwa_minio_admin
S3_SECRET_ACCESS_KEY=changeme_min_8_chars

# -----------------------------------------------------------------------------
# Caddy / domains
# -----------------------------------------------------------------------------
DOMAIN=sector43rwa.in
FILES_DOMAIN=files.sector43rwa.in
ACME_EMAIL=admin@sector43rwa.in
